<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <!-- SEGURIDAD: las pruebas NUNCA usan la base real (Aiven). Ver tests/TestCase.php -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_USERNAME" value="pruebas" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_ADMIN_USERNAME" value="pruebas" force="true"/>
        <env name="DB_ADMIN_PASSWORD" value="" force="true"/>
        <env name="APP_KEY" value="base64:dGVzdHNfbWlncmFzZW5zZV9jbGF2ZV9wcnVlYmFzMTI=" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="BREVO_API_KEY" value="" force="true"/>
        <env name="CORREO_REMITENTE" value="" force="true"/>
        <env name="CORREO_APPSSCRIPT_URL" value="" force="true"/>
        <env name="CORREO_APPSSCRIPT_SECRETO" value="" force="true"/>
        <env name="CORREO_RESPUESTA_MIN_MS" value="0" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
