APP_NAME=MigraSense
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos (usuario de la APP: privilegios mínimos) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=migrasense
DB_USERNAME=migrasense_app
DB_PASSWORD=CAMBIAR_POR_TU_CLAVE

# --- Usuario ADMIN: solo para `php artisan migrate --database=mysql_admin` ---
DB_ADMIN_USERNAME=root
DB_ADMIN_PASSWORD=

# --- Seguridad ---
HASH_DRIVER=argon2id
SANCTUM_EXPIRATION=720
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
