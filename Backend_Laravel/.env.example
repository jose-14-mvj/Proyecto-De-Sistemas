APP_NAME=MigraSense
APP_ENV=local
APP_KEY=
# true solo mientras desarrollas; en producción SIEMPRE false (si no, los errores muestran datos internos)
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos en Aiven (MySQL 8.4). Las CLAVES van SIEMPRE entre comillas ---
DB_CONNECTION=mysql
DB_HOST=mysql-1a49b297-migrasence.b.aivencloud.com
DB_PORT=23238
DB_DATABASE=migrasense
# Usuario de la APP (privilegios mínimos: SELECT, INSERT, UPDATE, DELETE, EXECUTE)
DB_USERNAME=migrasense_app
DB_PASSWORD=""

# Usuario ADMIN: solo para migrate, db:seed y migrasense:importar-sql (--database=mysql_admin)
DB_ADMIN_USERNAME=avnadmin
DB_ADMIN_PASSWORD=""

# Certificado de Aiven (Overview -> CA certificate). Ruta con "/" y fuera de Git (storage/certs/)
MYSQL_ATTR_SSL_CA=

# --- Servicio de predicción (ML en Render) ---
ML_URL=https://TU-SERVICIO-ML.onrender.com
ML_API_KEY=""
ML_TIMEOUT=20
ML_REINTENTOS=5
ML_PAUSA_MS=10000

# --- Correos: "¿Olvidaste tu contraseña?" (por HTTPS; Render gratis bloquea SMTP) ---
# Opción 1 (remitente @gmail.com): Google Apps Script → el correo sale desde Gmail de verdad
CORREO_APPSSCRIPT_URL=
CORREO_APPSSCRIPT_SECRETO=""
# Opción 2 (con dominio propio autenticado en Brevo). Si hay Apps Script, se usa Apps Script.
# Sin ninguna y con APP_ENV=local, el código se escribe en storage/logs/laravel.log
BREVO_API_KEY=""
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=MigraSense
FRONTEND_URL=https://migrasense.pages.dev

# En Render: "*" (confiar en su balanceador). En tu PC: vacío.
TRUSTED_PROXIES=

# --- Seguridad ---
HASH_DRIVER=argon2id
SANCTUM_EXPIRATION=720
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Recordatorios: notificaciones push y despertador (cron-job.org)
# Generar las claves con: php artisan migrasense:claves-push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu_correo@gmail.com"
CRON_CLAVE=""
